# Copy this file to deploy/.env. Never commit deploy/.env.
KAHANYAKU_DOMAIN=mcp.example.com
KAHANYAKU_PUBLIC_HOST=mcp.example.com
KAHANYAKU_ACTOR=agent:remote-mcp

# Default Bearer mode: use a long random token from your secret manager.
# Basic mode: replace this with the complete bcrypt hash emitted by Caddy.
# Compose intentionally refuses to start while this value is empty.
KAHANYAKU_CADDY_SECRET=

# These Basic-auth values are used only when KAHANYAKU_CADDYFILE is changed to
# ./Caddyfile.basic-auth. Generate the hash for KAHANYAKU_CADDY_SECRET with:
# docker run --rm caddy:2-alpine caddy hash-password
# Single quotes keep the dollar signs literal when Docker Compose reads .env.
KAHANYAKU_BASIC_USER=replace-with-user

# Bearer is the default because Codex and Claude can both send it.
# Keep an authenticated Caddyfile unless you deliberately follow the
# unauthenticated-public warning in docs/server-deployment.md.
KAHANYAKU_CADDYFILE=./Caddyfile.bearer.example
