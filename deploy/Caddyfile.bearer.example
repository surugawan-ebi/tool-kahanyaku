# The Authorization value is compared as an exact header value. Keep the token
# in deploy/.env or an external secret manager, never in this file.

{$KAHANYAKU_DOMAIN} {
	@authorized header Authorization "Bearer {$KAHANYAKU_CADDY_SECRET}"

	handle @authorized {
		reverse_proxy kahanyaku:3000 {
			header_up -Authorization
		}
	}

	handle {
		respond "Unauthorized" 401
	}
}
